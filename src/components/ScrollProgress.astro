---
// A thin progress bar rendered directly below the site header on long-form
// pages. It sticks to the top of the viewport while scrolling and fills from
// left to right to show how far down the page the visitor has read.
// (Not to be confused with ReadingProgress.astro, which tracks personal
// reading progress for works in the reading section.)
---

<div class="scroll-progress">
	<div
		class="scroll-progress-bar"
		role="progressbar"
		aria-label="Page reading progress"
		aria-valuemin="0"
		aria-valuemax="100"
		aria-valuenow="0"
		data-scroll-progress-bar
	></div>
</div>

<style>
	.scroll-progress {
		position: sticky;
		top: 0;
		z-index: 40;
		height: 4px;
		background: color-mix(in oklab, var(--color-base-content) 10%, transparent);
	}

	.scroll-progress-bar {
		height: 100%;
		width: 100%;
		transform: scaleX(0);
		transform-origin: 0 50%;
		background: var(--color-primary);
		will-change: transform;
	}

	@media (prefers-reduced-motion: reduce) {
		.scroll-progress-bar {
			will-change: auto;
		}
	}
</style>

<script>
	const bar = document.querySelector<HTMLElement>('[data-scroll-progress-bar]');

	if (bar) {
		let ticking = false;

		const update = () => {
			ticking = false;
			const scrollable = document.documentElement.scrollHeight - window.innerHeight;
			const progress = scrollable > 0 ? Math.min(window.scrollY / scrollable, 1) : 0;
			bar.style.transform = `scaleX(${progress})`;
			bar.setAttribute('aria-valuenow', String(Math.round(progress * 100)));
		};

		const requestUpdate = () => {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(update);
			}
		};

		window.addEventListener('scroll', requestUpdate, { passive: true });
		window.addEventListener('resize', requestUpdate);
		update();
	}
</script>
