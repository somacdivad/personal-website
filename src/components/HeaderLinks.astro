---
interface Link { label: string; href: string }
interface Props {
  items: ({ label: string; href: string; children?: never } | { label: string; children: Link[]; href?: never })[];
  mobile?: boolean;
}
const { items, mobile = false } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
function current(href: string) {
  const path = href.replace(/\/$/, '') || '/';
  if (pathname === path) return 'page';
  if (path !== '/' && pathname.startsWith(`${path}/`)) return 'location';
}
---
<ul class:list={['menu site-links', mobile ? 'menu-lg mobile-links' : 'menu-horizontal px-1 text-lg desktop-links']}>
  {items.map(item => <li>
    {item.children ? <details class="about-menu" data-nav-disclosure>
      <summary class:list={{ 'current-section': item.children.some(link => current(link.href)) }}>{item.label}</summary>
      <ul class="about-links">
        {item.children.map(link => <li><a href={link.href} aria-current={current(link.href)}>{link.label}</a></li>)}
      </ul>
    </details> : <a href={item.href} aria-current={current(item.href)}>{item.label}</a>}
  </li>)}
</ul>

<style>
  .site-links :is(a[aria-current], .current-section) {
    color: var(--text-heading);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: .35em;
    text-decoration-thickness: 2px;
  }
  .site-links :is(a, summary):focus-visible { outline: 2px solid var(--text-link); outline-offset: 2px; }
  .site-links summary { color: var(--text-body); }
  .desktop-links .about-menu { overflow: visible; }
  .desktop-links .about-links {
    z-index: 1000;
    margin-top: .5rem;
    min-width: 13rem;
    padding: .5rem;
    background: var(--color-base-200);
    box-shadow: 0 8px 20px color-mix(in oklab, var(--color-base-content) 12%, transparent);
  }
  .desktop-links .about-links::before { display: none; }
  .mobile-links { width: 100%; padding: .5rem; }
  .mobile-links .about-links { white-space: normal; }
</style>
