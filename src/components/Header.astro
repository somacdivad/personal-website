---
import { Icon } from 'astro-icon/components';
import HeaderLinks from './HeaderLinks.astro';
import { READING_BASE, READING_TITLE } from '../lib/reading';

const items = [
  { label: 'Home', href: '/' },
  { label: 'About me', children: [
    { label: 'My philosophy', href: '/about/philosophy/' },
    { label: READING_TITLE, href: READING_BASE },
  ] },
  { label: 'Blog', href: '/blog' },
  { label: 'Stories', href: '/stories' },
];
---

<nav class="navbar bg-base-100 shadow-md" aria-label="Main navigation" data-site-navigation>
  <div class="navbar-start">
    <details class="mobile-navigation lg:hidden" data-nav-disclosure>
      <summary class="btn btn-ghost" aria-label="Navigation menu">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" /> </svg>
      </summary>
      <div class="mobile-menu bg-base-200 rounded-box shadow-xl"><HeaderLinks items={items} mobile /></div>
    </details>
    <a class="btn btn-link text-2xl heading-font no-underline" href="/">david amos</a>
  </div>
  <div class="navbar-center hidden lg:flex">
    <HeaderLinks items={items} />
  </div>
  <div class="navbar-end">
    <a class="btn btn-square btn-ghost pt-0 mt-0">
      <label class="swap swap-rotate">
        <!-- this hidden checkbox controls the state -->
        <input type="checkbox" class="theme-controller" value="dracula" />

        <!-- sun icon -->
        <Icon name="ui/sun" class="swap-off h-7 w-7" />

        <!-- moon icon -->
        <Icon name="ui/moon" class="swap-on h-7 w-7" />
      </label>
    </a>
  </div>
</nav>

<style>
  .mobile-navigation { position: relative; }
  .mobile-navigation > summary { list-style: none; }
  .mobile-navigation > summary::-webkit-details-marker { display: none; }
  .mobile-navigation > summary:focus-visible { outline: 2px solid var(--text-link); outline-offset: 2px; }
  .mobile-menu { position: absolute; z-index: 1000; top: calc(100% + .75rem); left: 0; width: min(17rem, calc(100vw - 2rem)); }
</style>

<script>
  const navigation = document.querySelector<HTMLElement>('[data-site-navigation]');
  if (navigation) {
    const disclosures = [...navigation.querySelectorAll<HTMLDetailsElement>('[data-nav-disclosure]')];
    function close(details: HTMLDetailsElement) {
      details.open = false;
      details.querySelectorAll<HTMLDetailsElement>('details').forEach(child => child.open = false);
    }
    disclosures.forEach(details => details.addEventListener('toggle', () => {
      if (!details.open) close(details);
    }));
    document.addEventListener('click', event => {
      if (!(event.target instanceof Node)) return;
      disclosures.forEach(details => { if (!details.contains(event.target as Node)) close(details); });
    });
    navigation.addEventListener('focusout', event => {
      if (!(event.relatedTarget instanceof Node)) return;
      disclosures.forEach(details => { if (!details.contains(event.relatedTarget as Node)) close(details); });
    });
    document.addEventListener('keydown', event => {
      if (event.key !== 'Escape') return;
      const focused = event.target instanceof Element ? event.target.closest<HTMLDetailsElement>('details[open][data-nav-disclosure]') : null;
      const details = focused ?? [...disclosures].reverse().find(item => item.open);
      if (!details) return;
      event.preventDefault();
      close(details);
      details.querySelector<HTMLElement>('summary')?.focus();
    });
    window.addEventListener('pageshow', () => disclosures.forEach(close));
    window.matchMedia('(min-width: 1024px)').addEventListener('change', () => disclosures.forEach(close));
  }
</script>

<script is:inline>
  const themeToggle = document.querySelector('input.theme-controller[type="checkbox"]');
  const storageKey = 'themeToggleChecked';

  if (themeToggle instanceof HTMLInputElement) {
    const savedChecked = localStorage.getItem(storageKey);
    if (savedChecked !== null) {
      themeToggle.checked = savedChecked === 'true';
    }

    themeToggle.addEventListener('change', () => {
      localStorage.setItem(storageKey, String(themeToggle.checked));
    });
  }
</script>
