---
import { Icon } from 'astro-icon/components';

interface Props {
  href: string;
  class?: string;
}

const { href, class: className } = Astro.props;
---

<a class:list={['rss-link', className]} href={href}>
  <Icon name="ui/rss" width={18} height={18} aria-hidden="true" />
  Subscribe via RSS
</a>

<style>
  .rss-link { display: inline-flex; align-items: center; gap: .4rem; min-height: 44px; white-space: nowrap; color: var(--text-link); text-decoration: none; }
  .rss-link:hover { color: var(--text-link-hover); text-decoration: none; }
  .rss-link:focus-visible { outline: 2px solid var(--text-link); outline-offset: 5px; }
</style>
