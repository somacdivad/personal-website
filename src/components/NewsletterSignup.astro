---
interface Props {
	id?: string;
	title?: string;
	description?: string;
}

const {
	id = 'newsletter-signup',
	title = 'Subscribe',
	description = 'Get weekly updates delivered straight to your inbox.',
} = Astro.props;
---

<hr />
<section class="newsletter-signup" aria-labelledby={`${id}-heading`}>
	<h2 id={`${id}-heading`} class="newsletter-signup__heading">{title}</h2>
	<p class="newsletter-signup__description">{description}</p>
	<form
		action="https://buttondown.com/api/emails/embed-subscribe/davidamos"
		method="post"
		class="embeddable-buttondown-form"
	>
		<label for={`${id}-email`}>Enter your email</label>
		<div class="newsletter-signup__controls">
			<input
				type="email"
				name="email"
				id={`${id}-email`}
				class="input newsletter-signup__email"
				autocomplete="email"
				inputmode="email"
				autocapitalize="none"
				spellcheck="false"
				required
			/>
			<input type="hidden" name="embed" value="1" />
			<button type="submit" class="btn newsletter-signup__submit">Subscribe</button>
		</div>
	</form>
	<p class="newsletter-signup__credit">
		<a href="https://buttondown.com/refer/davidamos" target="_blank" rel="noopener noreferrer">
			Powered by Buttondown.
		</a>
		<a href="/rss.xml">Prefer RSS? Subscribe here</a>
	</p>
</section>

<style>
	.newsletter-signup {
		margin-block: 0 1rem;
	}

	.newsletter-signup__heading {
		margin: 0 0 0.75rem;
		font-size: 2rem;
	}

	.newsletter-signup__description {
		margin: 0 0 1.25rem;
	}

	.embeddable-buttondown-form label {
		display: block;
		margin-bottom: 0.5rem;
		font-size: 1rem;
		font-weight: 600;
	}

	.newsletter-signup__controls {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.newsletter-signup__email {
		flex: 1 1 16rem;
		min-width: 0;
		width: 100%;
		height: 3rem;
		background: var(--color-base-100);
		color: var(--text-body);
		border-color: var(--text-muted);
		font: inherit;
		font-size: 1rem;
		caret-color: var(--text-heading);
	}

	.newsletter-signup__submit {
		--btn-color: var(--text-heading);
		--btn-fg: var(--color-base-100);
		height: 3rem;
		padding-inline: 1.5rem;
		font: inherit;
		font-size: 1rem;
		font-weight: 600;
	}

	.newsletter-signup__email:focus-visible,
	.newsletter-signup__submit:focus-visible,
	.newsletter-signup__credit a:focus-visible {
		outline: 2px solid var(--text-heading);
		outline-offset: 3px;
	}

	.newsletter-signup__credit {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem 0.75rem;
		margin: 0.75rem 0 0;
		font-size: 0.8rem;
	}

	.newsletter-signup__credit a {
		display: inline-flex;
		align-items: center;
		gap: 0.3em;
		color: var(--text-muted);
		line-height: 1.5;
	}

	.newsletter-signup__credit a[href^="http"]::after {
		flex: 0 0 auto;
		width: 0.85em;
		height: 0.85em;
		margin-left: 0;
	}

	.newsletter-signup__credit a:hover {
		color: var(--text-link-hover);
	}

	@media (max-width: 480px) {
		.newsletter-signup__submit {
			width: 100%;
		}
	}
</style>
