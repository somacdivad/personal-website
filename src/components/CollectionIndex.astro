---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import FormattedDate from './FormattedDate.astro';
import { underlineStyle } from '../lib/hand-drawn-underline';
import '../styles/hand-drawn-underline.css';

interface Props {
  entries: CollectionEntry<'blog' | 'stories'>[];
  title: string;
  basePath: '/blog' | '/stories';
  itemLabel: string;
  itemPlural: string;
  tagNames?: Record<string, string>;
  initialTopic?: string;
}

const { entries, title, basePath, itemLabel, itemPlural, tagNames = {}, initialTopic = '' } = Astro.props;
const items = [...entries].sort((a, b) => +b.data.pubDate - +a.data.pubDate);
const visibleCount = items.filter(post => !initialTopic || post.data.tags.includes(initialTopic)).length;
const tags = [...new Set(items.flatMap(post => post.data.tags))].sort();
---

<main class="collection-index" data-collection-index data-base-path={basePath} data-item-label={itemLabel} data-item-plural={itemPlural} data-initial-topic={initialTopic}>
  <h1>{title}</h1>
  <nav class="topics" aria-label={`Filter ${itemPlural} by topic`}>
    <a class="hand-drawn-underline" style={underlineStyle(`${basePath}:all`)} href={`${basePath}/`} data-topic="" aria-current={!initialTopic ? 'true' : undefined}>All topics</a>
    {tags.map(tag => <a class="hand-drawn-underline" style={underlineStyle(`${basePath}:topic:${tag}`)} href={`${basePath}/tags/${encodeURIComponent(tag)}/`} data-topic={tag} aria-current={initialTopic === tag ? 'true' : undefined}>{tagNames[tag] ?? tag}</a>)}
  </nav>
  <div class="browse-controls">
    <p class="result-count" role="status">{visibleCount} {visibleCount === 1 ? itemLabel : itemPlural}{initialTopic && ` in ${tagNames[initialTopic] ?? initialTopic}`}</p>
    <div class="browse-actions">
      <label class="sort-control" hidden>Order:
        <select aria-label={`Sort ${itemPlural}`}>
          <option value="newest">Newest first</option>
          <option value="oldest">Oldest first</option>
          <option value="title">Title A–Z</option>
        </select>
      </label>
      <a class="rss-link" href={`${basePath}/rss.xml`}>
        <Icon name="ui/rss" width={18} height={18} aria-hidden="true" />
        Subscribe via RSS
      </a>
    </div>
  </div>
  <ul class="reading-list">
    {items.map(item => <li data-entry hidden={!!initialTopic && !item.data.tags.includes(initialTopic)} data-tags={JSON.stringify(item.data.tags)} data-title={item.data.title} data-date={+item.data.pubDate}>
      <a class:list={['post-link', { 'without-image': !item.data.heroImage }]} href={`${basePath}/${item.id}/`}>
        {item.data.heroImage && <Image src={item.data.heroImage} width={220} height={220} alt="" loading="lazy" />}
        <div class="post-copy">
          <h2>{item.data.title}</h2>
          <p class="post-date"><FormattedDate date={item.data.pubDate} />{item.data.draft && ' · Draft'}</p>
          {item.data.description && <p class="post-description">{item.data.description}</p>}
          {item.data.tags.length > 0 && <p class="post-tags">{item.data.tags.map(tag => tagNames[tag] ?? tag).join(' · ')}</p>}
        </div>
      </a>
    </li>)}
  </ul>
  <p class="empty-message" hidden={visibleCount > 0 || items.length === 0}>No {itemPlural} in this topic yet. <a href={`${basePath}/`} data-reset>Show all topics</a>.</p>
  {items.length === 0 && <p>Coming soon...</p>}
</main>

<script>
  const root = document.querySelector<HTMLElement>('[data-collection-index]');
  const list = root?.querySelector<HTMLUListElement>('.reading-list');
  const select = root?.querySelector<HTMLSelectElement>('select');
  if (root && list && select) {
    const entries = [...list.querySelectorAll<HTMLLIElement>('[data-entry]')];
    const topics = [...root.querySelectorAll<HTMLAnchorElement>('[data-topic]')];
    const count = root.querySelector<HTMLElement>('.result-count')!;
    const empty = root.querySelector<HTMLElement>('.empty-message')!;
    root.querySelector<HTMLElement>('.sort-control')!.hidden = false;
    const itemLabel = root.dataset.itemLabel!;
    const itemPlural = root.dataset.itemPlural!;
    let topic = '';

    function update() {
      const direction = select!.value === 'oldest' ? 1 : -1;
      entries.sort((a, b) => select!.value === 'title'
        ? a.dataset.title!.localeCompare(b.dataset.title!, 'en', { numeric: true })
        : direction * (Number(a.dataset.date) - Number(b.dataset.date)));
      let visible = 0;
      for (const entry of entries) {
        entry.hidden = !!topic && !JSON.parse(entry.dataset.tags!).includes(topic);
        if (!entry.hidden) visible++;
        list!.append(entry);
      }
      topics.forEach(link => {
        if (link.dataset.topic === topic) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
      const topicName = topics.find(link => link.dataset.topic === topic)?.textContent;
      count.textContent = `${visible} ${visible === 1 ? itemLabel : itemPlural}${topic && topicName ? ` in ${topicName}` : ''}`;
      empty.hidden = entries.length === 0 || visible > 0;
    }

    function readLocation() {
      const params = new URLSearchParams(location.search);
      topic = params.get('tag') ?? (location.pathname.startsWith(`${root!.dataset.basePath}/tags/`) ? root!.dataset.initialTopic ?? '' : '');
      const sort = params.get('sort');
      select!.value = sort === 'oldest' || sort === 'title' ? sort : 'newest';
      update();
    }

    function saveLocation() {
      const url = new URL(location.href);
      url.pathname = `${root!.dataset.basePath}/`;
      if (topic) url.searchParams.set('tag', topic);
      else url.searchParams.delete('tag');
      if (select!.value !== 'newest') url.searchParams.set('sort', select!.value);
      else url.searchParams.delete('sort');
      history.pushState(null, '', url);
      update();
    }

    topics.forEach(link => link.addEventListener('click', event => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      topic = link.dataset.topic!;
      saveLocation();
    }));
    root.querySelector('[data-reset]')!.addEventListener('click', event => {
      event.preventDefault();
      topic = '';
      saveLocation();
    });
    select.addEventListener('change', saveLocation);
    window.addEventListener('popstate', readLocation);
    readLocation();
  }
</script>

<style>
  .collection-index { width: 100%; box-sizing: border-box; max-width: 800px; padding: 0 1.25rem; margin: 2.5rem auto 5rem; }
  h1 { margin: 0 0 1em; text-align: center; }
  .topics { display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem 1.4rem; }
  .topics a { position: relative; display: inline-block; padding: .4rem 0 .7rem; text-decoration: none; color: var(--text-body); }
  .topics a[aria-current="true"] { font-weight: 700; color: var(--text-heading); }
  a:focus-visible, select:focus-visible { outline: 2px solid var(--text-link); outline-offset: 5px; }
  .topics a:hover, .post-link:hover h2 { color: var(--text-link-hover); }
  .browse-controls { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin: 1rem 0 1.8rem; font-size: .85rem; }
  .result-count { color: var(--text-muted); margin: 0; }
  .browse-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1.25rem; }
  .rss-link { display: inline-flex; align-items: center; gap: .4rem; min-height: 44px; white-space: nowrap; color: var(--text-link); text-decoration: none; }
  .rss-link:hover { color: var(--text-link-hover); }
  .sort-control { display: flex; align-items: center; gap: .5rem; }
  select { font: inherit; color: var(--text-body); background: var(--color-base-100); border: 0; padding: .4rem .2rem; }
  .reading-list { list-style: none; padding: 0; margin: 0; }
  .reading-list li { margin: 0 0 1.5rem; padding: 0 0 1.5rem; border-bottom: 1px solid color-mix(in oklab, var(--text-body) 18%, transparent); }
  .post-link { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 1.5rem; color: inherit; text-decoration: none; }
  .post-link.without-image { grid-template-columns: 1fr; }
  .post-link img { width: 110px; height: 110px; object-fit: cover; border-radius: 4px; }
  h2 { font-size: 1.35rem; line-height: 1.35; margin: 0; }
  .post-date { font-size: .85rem; margin: .35rem 0 0; color: var(--text-muted); }
  .post-description { font-size: .95rem; margin: .45rem 0 0; }
  .post-tags { font-size: .75rem; color: var(--text-muted); margin: .4rem 0 0; }
  [hidden] { display: none !important; }
  @media (max-width: 650px) {
    .collection-index { margin-top: 1.5rem; }
    .topics { gap: .35rem 1.2rem; }
    .browse-controls { flex-wrap: wrap; gap: .5rem; align-items: start; }
    .browse-actions { width: 100%; justify-content: space-between; }
    .post-link { grid-template-columns: 75px minmax(0, 1fr); gap: 1rem; }
    .post-link img { width: 75px; height: 85px; }
    h2 { font-size: 1.15rem; }
  }
</style>
