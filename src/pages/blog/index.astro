---
import { getBlogPosts } from '../../lib/blog';
import CollectionIndex from '../../components/CollectionIndex.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getBlogPosts();
const tagNames = { inputs: 'Inputs', music: 'Music', 'an-album-a-day': 'An Album a Day' };
---

<BaseLayout title="Blog" description="David Amos is waxing philosophical about technology, parenting, music, and life.">
  <CollectionIndex entries={posts} title="Blog" basePath="/blog" itemLabel="post" itemPlural="posts" tagNames={tagNames} />
</BaseLayout>
