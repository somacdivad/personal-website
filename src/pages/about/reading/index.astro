---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ReadingEntry from '../../../components/ReadingEntry.astro';
import RssLink from '../../../components/RssLink.astro';
import { READING_BASE, READING_TITLE, getReadingWorks, getReadingLists, readingDate } from '../../../lib/reading';
import '../../../styles/reading.css';
import { underlineStyle } from '../../../lib/hand-drawn-underline';
import '../../../styles/hand-drawn-underline.css';

const works = await getReadingWorks();
const { current, history, notes } = getReadingLists(works);
const years = [...new Set(history.map(({ session }) => session.archiveDate!.slice(0, 4)))];
---
<BaseLayout title={READING_TITLE} description="Books and other works I am currently reading and short notes on them.">
  <main class="reading-journal" data-reading-journal>
    <h1>{READING_TITLE}</h1>
    <p class="reading-intro">Books and other works I am currently reading and short notes on them.</p>
    <div class="reading-tools">
      {works.length > 0 && <div class="reading-kinds" role="group" aria-label="Work type" hidden data-reading-kinds>
        {[['', 'Everything'], ['book', 'Books'], ['shorter', 'Shorter works']].map(([kind, label]) => <button class="hand-drawn-underline" style={underlineStyle(`${READING_BASE}:${kind || 'all'}`)} type="button" data-kind-filter={kind} aria-pressed={kind === '' ? 'true' : 'false'}>{label}</button>)}
      </div>}
      <RssLink class="reading-rss" href={`${READING_BASE}rss.xml`} />
    </div>
    {works.length === 0 ? <p>No reading entries yet.</p> : <>
      <p hidden data-no-results role="status">No works match this type. <button type="button" class="reading-reset" data-reset-reading>Show everything</button>.</p>
      <section class="reading-section"><h2>Currently reading</h2><ul class="reading-list" data-reading-group="current">{current.map(({ work, session }) => <ReadingEntry work={work} session={session} current />)}</ul><p class="reading-meta" data-empty-group="current" hidden={current.length > 0}>Nothing currently reading.</p></section>
      <section class="reading-section"><h2>Recent notes</h2><ul class="reading-recent" data-reading-group="notes">{notes.map(({ work, update }, index) => <li data-reading-entry data-kind={work.entry.data.kind === 'book' ? 'book' : 'shorter'} hidden={index >= 6}>
        <h3><a href={update.href}>{work.entry.data.title}</a></h3><p class="reading-meta"><time datetime={update.entry.data.date}>{readingDate(update.entry.data.date)}</time>{update.entry.data.location && ` · ${update.entry.data.location}`}</p><p class="reading-note-preview"><Fragment set:html={update.previewHtml} /> <a class="reading-small-link" href={update.href}>Read note</a></p>
      </li>)}</ul><p class="reading-meta" data-empty-group="notes" hidden={notes.length > 0}>No reading notes yet.</p></section>
      <section class="reading-section"><h2>Reading history</h2><div data-reading-group="history">{years.map((year, index) => <details class="reading-year" open={index === 0}><summary>{year}</summary><ul class="reading-list">{history.filter(({ session }) => session.archiveDate!.startsWith(year)).map(({ work, session }) => <ReadingEntry work={work} session={session} />)}</ul></details>)}</div><p class="reading-meta" data-empty-group="history" hidden={history.length > 0}>No paused, stopped, or finished reading yet.</p></section>
    </>}
  </main>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-reading-journal]');
  const controls = root?.querySelector<HTMLElement>('[data-reading-kinds]');
  if (root && controls) {
    const kinds = [...controls.querySelectorAll<HTMLButtonElement>('[data-kind-filter]')];
    const entries = [...root.querySelectorAll<HTMLElement>('[data-reading-entry]')];
    let kind = '';
    function apply() {
      for (const element of entries) {
        element.hidden = !!kind && element.dataset.kind !== kind;
      }
      kinds.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.kindFilter === kind)));
      const recent = [...root!.querySelectorAll<HTMLElement>('[data-reading-group="notes"] > li')].filter(item => !item.hidden);
      recent.slice(6).forEach(item => item.hidden = true);
      let firstYear = true;
      root!.querySelectorAll<HTMLDetailsElement>('.reading-year').forEach(year => {
        year.hidden = ![...year.querySelectorAll<HTMLElement>('[data-reading-entry]')].some(item => !item.hidden);
        year.open = !year.hidden && firstYear;
        if (!year.hidden) firstYear = false;
      });
      for (const name of ['current', 'notes', 'history']) {
        const hasEntries = [...root!.querySelectorAll<HTMLElement>(`[data-reading-group="${name}"] [data-reading-entry]`)].some(item => !item.hidden);
        root!.querySelector<HTMLElement>(`[data-empty-group="${name}"]`)!.hidden = hasEntries;
      }
      root!.querySelector<HTMLElement>('[data-no-results]')!.hidden = entries.some(element => !element.hidden);
      revealAnchor();
    }
    function revealAnchor() {
      const id = location.hash.slice(1);
      const target = document.getElementById(id);
      const year = target?.closest<HTMLDetailsElement>('details');
      if (year && !year.hidden) year.open = true;
    }
    function readLocation() {
      const params = new URLSearchParams(location.search);
      kind = ['book', 'shorter'].includes(params.get('kind') ?? '') ? params.get('kind')! : '';
      apply();
    }
    function saveLocation() {
      const url = new URL(location.href);
      if (kind) url.searchParams.set('kind', kind);
      else url.searchParams.delete('kind');
      url.searchParams.delete('status');
      url.searchParams.delete('tag');
      history.pushState(null, '', url);
      apply();
    }
    function reset() { kind = ''; saveLocation(); }
    kinds.forEach(button => button.addEventListener('click', () => { kind = button.dataset.kindFilter!; saveLocation(); }));
    root.querySelector('[data-reset-reading]')!.addEventListener('click', reset);
    window.addEventListener('popstate', readLocation);
    window.addEventListener('hashchange', revealAnchor);
    readLocation();
    controls.hidden = false;
  }
</script>
