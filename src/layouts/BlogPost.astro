---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import KoFiButton from '../components/KoFiButton.astro';


type Props = Pick<CollectionEntry<'blog'>['data'], 'title' | 'description' | 'pubDate' | 'updatedDate' | 'heroImage'> & {
	tags?: string[];
	tagBasePath?: string;
	preview?: boolean;
	showNewsletter?: boolean;
	showSupport?: boolean;
};

const { title, description, pubDate, updatedDate, heroImage, tags = [], tagBasePath = '/blog/tags', preview = false, showNewsletter = false, showSupport = false } = Astro.props;
---

<BaseLayout
    title={title}
    description={description}
	image={heroImage}
	preview={preview}
>
	<article>
		<div class="hero-image mt-4">
			{heroImage && (
				<Image
					src={heroImage}
					width={1020}
					height={heroImage.width === heroImage.height ? 1020 : 510}
					widths={[400, 640, 800, 1020]}
					sizes="(max-width: 840px) calc(100vw - 40px), 800px"
					quality={70}
					priority
					alt=""
				/>
			)}
		</div>
		<div class="prose">
			<div class="title">
				<div class="date">
					<FormattedDate date={pubDate} />
					{
						updatedDate && (updatedDate.getDate() > pubDate.getDate()) && (
							<div class="last-updated-on">
								Last updated on <FormattedDate date={updatedDate} />
							</div>
						)
					}
				</div>
				<h1>{title}</h1>
				{tags.length > 0 && (
					<div class="flex flex-row justify-center gap-2 mb-7">
						{tags.map((tag: string) => (
							<a href={`${tagBasePath}/${encodeURIComponent(tag)}/`} class="badge badge-soft badge-accent">{tag}</a>
						))}
					</div>
				)}
				<hr />
			</div>
			<main>
				<slot />
				{showSupport && !preview && <KoFiButton />}
				{showNewsletter && !preview && <NewsletterSignup />}
			</main>
		</div>
	</article>
</BaseLayout>
