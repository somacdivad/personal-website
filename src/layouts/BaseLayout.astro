---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SOCIAL_LINKS } from '../consts';

const { title, description, image, preview = false } = Astro.props;

const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
---

<!doctype html>
<html lang="en" data-theme="bumblebee">
	<head>
		<BaseHead
			title={pageTitle}
			description={description ?? SITE_DESCRIPTION}
			image={image}
			preview={preview}
		/>
	</head>
	<body>
		<Header />
		<slot />
		<Footer />
	</body>
</html>

<script>
	const dividerStrokes = ['01', '02', '03', '05', '18'];

	function applyDividerCycle() {
		document.querySelectorAll<HTMLHRElement>('hr').forEach((rule, index) => {
			const stroke = dividerStrokes[index % dividerStrokes.length];
			rule.style.setProperty('--divider-image', `url('/icons/dividers/${stroke}.svg')`);
		});
	}

	applyDividerCycle();
	document.addEventListener('astro:page-load', applyDividerCycle);
</script>
